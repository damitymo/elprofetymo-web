# Copiá este archivo como .env.local y completalo con tus valores reales.

# URL pública del sitio (cambia entre dev / prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Opcional) Tu usuario de GitHub si activás sync automático de proyectos
# GITHUB_USERNAME=tu-usuario

# (Opcional) Token personal de GitHub (lectura) si llamás a la API autenticado
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
